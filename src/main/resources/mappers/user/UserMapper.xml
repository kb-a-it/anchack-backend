<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbait.anchack.user.mapper.UserMapper">

  <!-- users 테이블 조회 결과를 User 객체에 매핑한다. -->
  <resultMap id="userResultMap"
             type="com.kbait.anchack.user.domain.User">

    <id property="id"
        column="user_id"/>

    <result property="provider"
            column="provider"/>

    <result property="providerId"
            column="provider_id"/>

    <result property="nickname"
            column="nickname"/>

    <result property="profileImageUrl"
            column="profile_image_url"/>

    <result property="email"
            column="email"/>

    <result property="birthDate"
            column="birth_date"/>

  </resultMap>

  <!-- 사용자 ID로 사용자를 조회한다. -->
  <select id="findById"
          resultMap="userResultMap">

    SELECT
    user_id,
    provider,
    provider_id,
    nickname,
    profile_image_url,
    email,
    birth_date
    FROM users
    WHERE user_id = #{userId}

  </select>

  <!-- 사용자가 마이페이지에서 프로필을 수정한다. -->
  <update id="updateProfile"
          parameterType="com.kbait.anchack.user.domain.User">

    UPDATE users
    SET
    nickname = #{nickname},
    birth_date = #{birthDate},
    profile_image_url = #{profileImageUrl},
    updated_at = NOW()
    WHERE user_id = #{id}

  </update>

</mapper>
